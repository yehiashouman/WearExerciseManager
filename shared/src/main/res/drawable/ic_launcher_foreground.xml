<?xml version="1.0" encoding="utf-8"?>
<!--
    Exercise Manager launcher artwork: an orange runner in motion in front of a stopwatch.
    Drawn as a vector so it stays sharp on every watch and phone density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled so the whole artwork stays inside the circular adaptive-icon safe zone. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.74"
        android:scaleY="0.74">

        <!-- Stopwatch ring, left open where the runner crosses it. -->
        <path
            android:pathData="M55.4,34.5 A25,25 0 1 1 42.4,70.5"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />

        <!-- Crown: stem and top bar. -->
        <path
            android:pathData="M60,24h8v9h-8z"
            android:fillColor="#FF7A1A" />
        <path
            android:pathData="M55,17h18a3,3 0 0 1 3,3v2a3,3 0 0 1 -3,3h-18a3,3 0 0 1 -3,-3v-2a3,3 0 0 1 3,-3z"
            android:fillColor="#FF7A1A" />

        <!-- Side button. -->
        <path
            android:pathData="M82.5,32.5l4,-4l9,9l-4,4z"
            android:fillColor="#FF7A1A" />

        <!-- Dial ticks. -->
        <path
            android:pathData="M82.2,47.5l-4.3,2.5"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M85,58h-5"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M82.2,68.5l-4.3,-2.5"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />

        <!-- Speed lines. -->
        <path
            android:pathData="M24,41h20"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M15,52h22"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M19,63h20"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="6"
            android:strokeLineCap="round" />

        <!-- Runner. -->
        <path
            android:pathData="M57,45m-7,0a7,7 0 1 1 14,0a7,7 0 1 1 -14,0"
            android:fillColor="#FF7A1A" />
        <path
            android:pathData="M54,54L44,67"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <path
            android:pathData="M52,56L39,53"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M53,55L65,53L70,60"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M45,66L57,74L53,87"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M45,67L29,86"
            android:strokeColor="#FF7A1A"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
    </group>
</vector>
